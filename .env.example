# ============================================================================
# Google Cloud Project & Regional Settings
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012

# Location of Cloud SDP (DLP) & Cloud Model Armor templates (e.g., us, global)
SDP_LOCATION=us

# Regional compute runtime for Vertex AI Agent Engine (e.g., us-west1, us-central1)
AGENT_ENGINE_REGION=us-west1

# Vertex AI endpoint location for Gemini & Discovery Engine Data Store grounding
VERTEX_LOCATION=global

# Primary and optional fallback Gemini model identifiers
GEMINI_MODEL=gemini-2.5-flash
FALLBACK_GEMINI_MODEL=gemini-3.5-flash

# ============================================================================
# Cloud Model Armor & Cloud Sensitive Data Protection (SDP) Templates
# ============================================================================
MODEL_ARMOR_PROMPT_TEMPLATE_ID=your-prompt-filter-template
MODEL_ARMOR_RESPONSE_TEMPLATE_ID=your-response-filter-template

SDP_INSPECT_TEMPLATE_PATH=projects/your-gcp-project-id/locations/us/inspectTemplates/your-inspect-template
SDP_DEIDENTIFY_TEMPLATE_PATH=projects/your-gcp-project-id/locations/us/deidentifyTemplates/your-deidentify-template

# ============================================================================
# Gemini Enterprise & Discovery Engine Data Store Grounding
# ============================================================================
GEMINI_ENTERPRISE_ENGINE_ID=your-gemini-enterprise-engine-id
DISCOVERY_ENGINE_DATA_STORE_ID=projects/123456789012/locations/global/collections/default_collection/dataStores/your-data-store-id

# Feature toggles
ENABLE_DATASTORE_SEARCH=true
ENABLE_MODEL_ARMOR_API=true
ENABLE_SUPPLEMENTAL_INSPECT_CONFIG=true

# Optional: Dedicated runtime service account for Agent Engine deployment
AGENT_SERVICE_ACCOUNT=adk-sdp-agent-sa@your-gcp-project-id.iam.gserviceaccount.com
